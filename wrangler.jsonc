// Configuración para publicar la página en Cloudflare Workers (sitio estático).
// No hay código de servidor: Cloudflare solo sirve los archivos de esta carpeta.
{
	"name": "aurora-casa-de-sabores",
	"compatibility_date": "2026-11-21",
	// Dominio propio: Cloudflare crea los registros DNS y el certificado HTTPS solo
	"routes": [
		{ "pattern": "auroracasadesabores.com", "custom_domain": true },
		{ "pattern": "www.auroracasadesabores.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./"
	}
}
